# Ollama normally listens here. Change this if you run Ollama elsewhere.
OLLAMA_URL=http://127.0.0.1:11434

# Any model installed with `ollama pull ...` can be used.
OLLAMA_MODEL=phi4

# Increase this for larger models or a slow first load (milliseconds).
OLLAMA_TIMEOUT_MS=120000

# Local Piper speech service and Semaine speaker used by narration.
PIPER_URL=http://127.0.0.1:5000
PIPER_SPEAKER_ID=3
# Optional startup overrides; defaults match the local installation.
PIPER_MODEL=en_GB-semaine-medium
PIPER_DATA_DIR=data/piper
# PIPER_PYTHON=.venv-piper/Scripts/python.exe

# Default pause after any research session finishes (milliseconds).
# Browser "Server setting (.env)" uses this; an explicit browser duration overrides it.
# Example: 120000 for two minutes. Positive whole milliseconds; no five-minute floor.
SELF_RESEARCH_INTERVAL_MS=300000

# The server listens on this port.
PORT=3000
